[
  {
    "name": "Install Rust toolchain",
    "uses": {
      "repo": "dtolnay/rust-toolchain",
      "sha": "d124f86f28ff42855784ff3319f48ac182c248f8",
      "version": "1.99"
    },
    "with": {
      "components": "clippy, rustfmt",
      "toolchain": "1.99"
    }
  },
  {
    "name": "Cache cargo registry and target",
    "uses": {
      "repo": "Swatinem/rust-cache",
      "sha": "d1527c8f67ef9af357290475d4af4b0fab8f12e0",
      "version": "v2.9.3"
    },
    "with": {
      "save-if": "${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}",
      "workspaces": "services/api"
    }
  },
  {
    "name": "Install cargo-nextest",
    "uses": {
      "repo": "taiki-e/install-action",
      "sha": "5488ac5a951645ce95062214902ac4b6bc1a1037",
      "version": "v2.87.32"
    },
    "with": {
      "tool": "nextest@0.9.150"
    }
  }
]
